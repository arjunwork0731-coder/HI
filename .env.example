# Pick ONE provider key. Groq has a free tier and is fast: https://console.groq.com/keys
GROQ_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Optional overrides
# LLM_MODEL=llama-3.3-70b-versatile        # generator agents
# VERIFIER_MODEL=llama-3.1-8b-instant      # independent judge / critic (use a different model for independence)
# LLM_BASE_URL=                            # any OpenAI-compatible endpoint (with LLM_API_KEY)
# ENABLE_WEB=1                             # Wikipedia retrieval
# MAX_ROUNDS=3                             # self-correction budget
# ACCEPT_THRESHOLD=0.55                    # minimum verified confidence to accept
# FORCE_OFFLINE=1                          # ignore keys, run deterministic agents only
